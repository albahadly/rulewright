<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The RuleWright rule engine — everything you need in one package: the core domain model, JSON parsing and schema validation, the expression-tree evaluation engine, the System.Text.Json adapter, and the built-in custom functions. Rules are plain JSON; evaluation is compiled expression trees. Install this unless you want to pick pieces individually.</Description>
    <!-- A metapackage: it carries no code of its own, only the reference set. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <!--
      No build output means no PDBs, so the inherited IncludeSymbols would pack an empty
      .snupkg — which nuget.org rejects outright with "400 The package does not contain any
      symbol (.pdb) files", failing the push mid-run. Symbols for the actual code live in the
      five referenced packages.
    -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RuleWright.Core\RuleWright.Core.csproj" />
    <ProjectReference Include="..\RuleWright.Serialization\RuleWright.Serialization.csproj" />
    <ProjectReference Include="..\RuleWright.Execution\RuleWright.Execution.csproj" />
    <ProjectReference Include="..\RuleWright.Json.SystemText\RuleWright.Json.SystemText.csproj" />
    <ProjectReference Include="..\RuleWright.Extensions.Functions\RuleWright.Extensions.Functions.csproj" />
  </ItemGroup>

</Project>
