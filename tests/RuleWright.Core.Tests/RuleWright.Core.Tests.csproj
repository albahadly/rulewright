<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Every shipped leg that can host a test run. netstandard2.0 has no runtime of
         its own; net8.0 covers it, since that is the leg a netstandard2.0 consumer resolves. -->
    <TargetFrameworks>net8.0;net10.0;net48</TargetFrameworks>
    <!-- xUnit v3 test projects are self-contained executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RuleWright.Core\RuleWright.Core.csproj" />
  </ItemGroup>

</Project>
