<Project>
  <!--
    Every dependency version is pinned exactly (no floating versions, no ranges).
    The core libraries carry no dependencies at all; the only shipped references are
    the two JSON adapters' own libraries, each confined to the one package that owns
    that format.
  -->
  <ItemGroup>
    <!-- Shipped: JSON adapter packages. -->
    <!-- Rulewright.Json.NewtonsoftJson ONLY. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!--
      Rulewright.Json.SystemText ONLY, and only on the down-level legs — net8.0 and
      net10.0 have System.Text.Json in-box and must not take a package reference for it.
    -->
    <PackageVersion Include="System.Text.Json" Version="10.0.10" />
    <!-- Build infrastructure. Source Link is in the SDK, not a package, from .NET 8 on. -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <!-- Tests. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Benchmarks (never shipped). -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="NRules" Version="1.0.4" />
    <PackageVersion Include="RulesEngine" Version="6.0.1" />
    <!-- Samples (never shipped). These track the Blazor sample's own framework, net10.0. -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" />
  </ItemGroup>
</Project>
